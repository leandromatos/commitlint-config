{
  "name": "@leandromatos/commitlint-config",
  "version": "0.6.0-snapshot.20260701.3",
  "repository": "https://github.com/leandromatos/commitlint-config",
  "author": "Leandro Matos",
  "license": "MIT",
  "keywords": [
    "commitlint"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    }
  },
  "files": [
    "./lib/**",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "clean": "rimraf lib/*",
    "lint:fix": "yarn lint --fix",
    "lint": "eslint .",
    "prepare": "husky",
    "test:cov": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "test": "vitest run --pass-with-no-tests",
    "tsc": "tsc --noEmit",
    "release": "commit-and-tag-version",
    "release:snapshot": "./scripts/snapshot-version-bump.sh",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major"
  },
  "dependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0"
  },
  "devDependencies": {
    "@commitlint/types": "^21.2.0",
    "@leandromatos/eslint-config": "^3.0.0-snapshot.20260701.3",
    "@leandromatos/prettier-config": "^2.0.0-snapshot.20260701.2",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "commit-and-tag-version": "^12.7.3",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@commitlint/cli": ">=19"
  },
  "publishConfig": {
    "access": "public"
  }
}
