{
  "name": "@leandromatos/commitlint-config",
  "version": "1.1.3",
  "description": "Commitlint configuration based on Conventional Commits, with selective-scope and subject-release rules.",
  "keywords": [
    "commitlint",
    "config"
  ],
  "license": "MIT",
  "author": "Leandro Matos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandromatos/commitlint-config.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "./dist/**",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "pnpm run clean:build && pnpm run compile && pnpm run resolve-alias",
    "clean:build": "rm -rf dist/*",
    "compile": "tsc --project tsconfig.build.json",
    "resolve-alias": "tsc-alias --project tsconfig.build.json",
    "lint": "pnpm run lint:ts && pnpm run lint:js && pnpm run lint:md",
    "lint:ts": "tsc --project tsconfig.json",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:fix": "pnpm run lint:fix:js && pnpm run lint:fix:md",
    "lint:fix:js": "eslint . --fix",
    "lint:fix:md": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "prepare": "husky",
    "test:cov": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "test": "pnpm run test:js && pnpm run test:sh",
    "test:js": "vitest run --pass-with-no-tests",
    "test:sh": "bats --recursive scripts/release/__tests__",
    "release:snapshot": "./scripts/release/snapshot.sh",
    "release:production": "./scripts/release/production.sh"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@leandromatos/eslint-config": "^3.2.0",
    "@leandromatos/prettier-config": "^2.1.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "bats": "^1.13.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "tsc-alias": "^1.9.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
